# Environment variables for the PocketBase service on Railway.
# Set these in Railway, project rsda-pocketbase, Variables tab.
# Never commit real values.

# API key from resend.com, used by the hooks to send enquiry emails
RESEND_API_KEY=

# Superuser for the PocketBase admin panel. Upserted on every container start,
# so change the password here, not only in the admin panel.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
